{
  "name": "locio",
  "version": "1.0.1",
  "description": "A powerful CLI tool to count lines and files in directories with extensive filtering options",
  "type": "module",
  "bin": {
    "locio": "./dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "format": "prettier --write \"**/*.{js,json,ts,md}\"",
    "test": "vitest run",
    "benchmark": "vitest run tests/benchmarks"
  },
  "keywords": [
    "cli",
    "LocIO",
    "file-counter",
    "statistics",
    "code-analysis",
    "lines-of-code",
    "code-stats"
  ],
  "author": "Toufiq Hasan Kiron <hello@kiron.dev>",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kiron0/locio.git"
  },
  "homepage": "https://locio.js.org",
  "bugs": {
    "url": "https://github.com/kiron0/locio/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.2",
    "chalk": "^5.6.2",
    "ignore": "^7.0.5",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "prettier": "^3.7.4",
    "terser": "^5.44.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
