{
  "name": "locio",
  "version": "1.1.0",
  "description": "A powerful CLI tool to count lines and files in directories with extensive filtering options",
  "type": "module",
  "bin": {
    "locio": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "format": "prettier --write \"**/*.{js,json,ts,md}\"",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "benchmark": "vitest run tests/benchmarks"
  },
  "keywords": [
    "cli",
    "LocIO",
    "file-counter",
    "statistics",
    "code-analysis",
    "lines-of-code",
    "code-stats"
  ],
  "author": "Toufiq Hasan Kiron <hello@kiron.dev>",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kiron0/locio"
  },
  "homepage": "https://locio.js.org",
  "bugs": {
    "url": "https://github.com/kiron0/locio/issues"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "terser": "^5.49.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
